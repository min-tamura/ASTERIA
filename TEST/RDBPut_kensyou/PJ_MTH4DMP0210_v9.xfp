		<fe:Component fb:x="560" fb:y="16" name="RDBGet_update" type="RDB(Get)">
			<fb:Description height="17" visible="false" width="111" x="596" y="16">
				<fb:Property name="Text">更新対象を抽出</fb:Property>
			</fb:Description>
			<fe:Property name="Exception"/>
			<fe:Property name="ConnectException"/>
			<fe:Property name="RecordNotFoundException"/>
			<fe:Property name="Connection">DMPDEV</fe:Property>
			<fe:Property name="SQL">SELECT wk.*
FROM dmap.dihsample_if_prescription_detail wk
WHERE EXISTS (
    SELECT 1 FROM dmap.if_prescription_detail t
    WHERE t.prescription_no = wk.prescription_no
      AND t.prescription_detail_no = wk.prescription_detail_no
)</fe:Property>
			<fe:Property name="RecordFilter">false</fe:Property>
