		<fe:Component fb:x="458" fb:y="16" name="RecordSQL1" type="RecordSQL">
			<fe:Property name="Exception"/>
			<fe:Property name="RecordNotFoundException"/>
			<fe:Property name="Mode">OnMemory</fe:Property>
			<fe:Property name="Connection"/>
			<fe:Property name="SQL">INSERT INTO in[2]&#xd;
(&#xd;
    field[1],&#xd;
    field[2],&#xd;
    field[3],&#xd;
    field[4],&#xd;
    field[5],&#xd;
    field[6],&#xd;
    field[7],&#xd;
    field[8],&#xd;
    field[9],&#xd;
    field[10],&#xd;
    field[11],&#xd;
    field[12]&#xd;
)&#xd;
SELECT&#xd;
    field[1],&#xd;
    field[2],&#xd;
    field[3],&#xd;
    field[4],&#xd;
    field[5],&#xd;
    field[6],&#xd;
    field[7],&#xd;
    field[8],&#xd;
    field[9],&#xd;
    field[10],&#xd;
    field[11],&#xd;
    field[12]&#xd;
FROM in[1]&#xd;
ON CONFLICT( in[1].field[1] in[1].field[2])&#xd;
DO UPDATE&#xd;
SET&#xd;
    field[3] = EXCLUDED.field[3],&#xd;
    field[4] = EXCLUDED.field[4],&#xd;
    field[5] = EXCLUDED.field[5],&#xd;
    field[6] = EXCLUDED.field[6],&#xd;
    field[7] = EXCLUDED.field[7],&#xd;
    field[8] = EXCLUDED.field[8],&#xd;
    field[9] = EXCLUDED.field[9],&#xd;
    field[10] = EXCLUDED.field[10],&#xd;
    field[11] = EXCLUDED.field[11],&#xd;
    field[12] = EXCLUDED.field[12];</fe:Property>
			<fe:Property name="LoopProcess">false</fe:Property>
			<fe:Property name="Detail" unfold="true">
				<fe:Property name="Precision">30</fe:Property>
				<fe:Property name="Scale">5</fe:Property>
				<fe:Property name="StripTrailingZeros">true</fe:Property>
			</fe:Property>
			<fe:Input>
				<fe:Item>Link11</fe:Item>
				<fe:Item>Link12</fe:Item>
			</fe:Input>
			<fe:Output>
				<fe:SyncDef component="RDBPut1"/>
			</fe:Output>
		</fe:Component>
