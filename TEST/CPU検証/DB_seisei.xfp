			<fe:Property name="Mode">SQL</fe:Property>
			<fe:Property name="SQL">INSERT INTO public.test_data&#xd;
(&#xd;
    col01,&#xd;
    col02,&#xd;
    col03,&#xd;
    col04,&#xd;
    col05,&#xd;
    col06,&#xd;
    col07,&#xd;
    col08,&#xd;
    col09,&#xd;
    col10,&#xd;
    col11,&#xd;
    col12&#xd;
)&#xd;
SELECT&#xd;
    col01,&#xd;
    col02,&#xd;
    col03,&#xd;
    col04,&#xd;
    col05,&#xd;
    col06,&#xd;
    col07,&#xd;
    col08,&#xd;
    col09,&#xd;
    col10,&#xd;
    col11,&#xd;
    col12&#xd;
FROM public.work_data&#xd;
ON CONFLICT(col01,col02)&#xd;
DO UPDATE&#xd;
SET&#xd;
    col03 = EXCLUDED.col03,&#xd;
    col04 = EXCLUDED.col04,&#xd;
    col05 = EXCLUDED.col05,&#xd;
    col06 = EXCLUDED.col06,&#xd;
    col07 = EXCLUDED.col07,&#xd;
    col08 = EXCLUDED.col08,&#xd;
    col09 = EXCLUDED.col09,&#xd;
    col10 = EXCLUDED.col10,&#xd;
    col11 = EXCLUDED.col11,&#xd;
    col12 = EXCLUDED.col12;</fe:Property>
